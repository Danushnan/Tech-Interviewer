# SQLite runs immediately without Docker. Docker Compose overrides this with MySQL.
DATABASE_URL=sqlite:///./prepwise.db
# demo | openai | openrouter
LLM_PROVIDER=demo
LLM_API_KEY=
# Set a model supported by your provider. OpenRouter's free router: openrouter/free
LLM_MODEL=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://localhost:8080
# Optional: uv pip install faster-whisper, then enable. First use downloads weights.
ENABLE_WHISPER=false
WHISPER_MODEL=base
# For Docker Compose, set your own alphanumeric passwords before starting.
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
